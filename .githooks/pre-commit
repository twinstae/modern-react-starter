#!/bin/sh
# book-curator 파일이 스테이징되면 앱 정적 검사와, 스테이징된 파일에 관련된 테스트만 돌린다.
# 활성화: git config core.hooksPath .githooks
set -e

staged=$(git diff --cached --name-only --diff-filter=ACM -- apps/book-curator | sed 's#^apps/book-curator/##')
if [ -z "$staged" ]; then
  exit 0
fi

cd apps/book-curator
echo "book-curator: 정적 검사를 돌립니다..."
bun run check:static
echo "book-curator: 스테이징된 파일에 관련된 테스트를 돌립니다..."
# shellcheck disable=SC2086
bunx vp test related --run --passWithNoTests $staged
