{
  "name": "modern-react-starter",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1 -- run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "deps:check": "bun scripts/catalog.mjs check",
    "deps:fix": "bun scripts/catalog.mjs fix",
    "ci": "bun run lint:fix && bun run format && bun run deps:check && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "turbo": "^2.11.8",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.3",
  "catalog": {
    "@electric-sql/pglite": "^0.5.10",
    "@elysiajs/eden": "^1.4.9",
    "@pandacss/dev": "^2.2.0",
    "@pandacss/preset-base": "^2.2.0",
    "@pandacss/preset-panda": "^2.2.0",
    "@pandacss/vite": "^2.2.0",
    "@siheom/react": "^0.4.0",
    "@standard-schema/spec": "^1.1.0",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "lucide-react": "^1.57.0",
    "nitro": "3.0.260903-beta",
    "playwright": "^1.16.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.2",
    "temporal-polyfill": "^1.0.6",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
