{
  "name": "modern-react-starter",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test -- run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "ci": "bun run lint:fix && bun run format && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "turbo": "^2.11.8",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.3"
}
